__pycache__/
*.pyc
.ipynb_checkpoints/

# Individual-level UKB data (genotypes, per-eid phenotypes, joined sample) —
# do NOT commit per UKB data sharing terms.
results/intermediate/
results/variant/
results/lmm_inputs/
results/lmm/regenie_step1*
results/lmm/regenie_step1_tmp*
results/lmm/*.loco
results/lmm/*.loco.gz
results/lmm/bolt_*.stats
# Per-eid derived score tables (composites + ROI PCs). The per-tract
# summary loadings (roi_pca_loadings.csv) and per-phenotype association
# stats are fine to commit.
results/composite_phenotypes.csv
results/roi_pca_phenotypes.csv

# Per-run timestamped output dirs (only relevant if overwrite=false)
results/2*/

# Verbose logs — keep inspect_report + model_warnings + versions (small,
# useful for reproducibility); skip the giant per-step run log.
logs/run_log.txt
logs/*.log

# OS junk
.DS_Store
.pytest_cache/

# sbatch runtime config tempfiles (live in repo root so `_repo_root`
# resolves correctly; cleaned up by trap on job exit, but left if killed)
runtime_config.*.yaml
